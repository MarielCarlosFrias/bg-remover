#!/bin/bash
# Verifica se os filtros M5 tem DEFINICAO no componente de
# pos-processamento, nao so chamadas.

FILE="@CMAKE_SOURCE_DIR@/imagepostprocessor.cpp"

THRESHOLD_DEFS=$(grep -c "QImage ImagePostProcessor::applyAlphaThreshold" "$FILE")
REFINE_DEFS=$(grep -c "QImage ImagePostProcessor::applyEdgeRefinement" "$FILE")

if [ "$THRESHOLD_DEFS" -ne 1 ] || [ "$REFINE_DEFS" -ne 1 ]; then
    echo "ERRO: definicao de applyAlphaThreshold ($THRESHOLD_DEFS) ou applyEdgeRefinement ($REFINE_DEFS) ausente ou duplicada em imagepostprocessor.cpp"
    exit 1
fi
echo "OK: definicoes de applyAlphaThreshold e applyEdgeRefinement presentes"
